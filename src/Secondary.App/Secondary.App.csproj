<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.22621.57</WindowsSdkPackageVersion>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget><ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Secondary.Core/Secondary.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <Content Include="../../.tools/monitoring/PresentMon-2.6.0-x64.exe" Condition="Exists('../../.tools/monitoring/PresentMon-2.6.0-x64.exe')" Link="Monitoring/PresentMon-2.6.0-x64.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../third-party/PresentMon-LICENSE.txt" Link="Monitoring/PresentMon-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../Secondary.SensorHelper/Secondary.SensorHelper.csproj" ReferenceOutputAssembly="false" /></ItemGroup>
  <Target Name="CopySensorHelper" AfterTargets="Build">
    <ItemGroup><SensorHelperFiles Include="../Secondary.SensorHelper/bin/$(Configuration)/net10.0-windows/**/*" /></ItemGroup>
    <Copy SourceFiles="@(SensorHelperFiles)" DestinationFiles="@(SensorHelperFiles->'$(OutDir)SensorHelper/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishSensorHelper" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <SensorPublishFiles Include="../Secondary.SensorHelper/bin/$(Configuration)/net10.0-windows/**/*" />
      <ResolvedFileToPublish Include="@(SensorPublishFiles)">
        <RelativePath>SensorHelper/%(SensorPublishFiles.RecursiveDir)%(SensorPublishFiles.Filename)%(SensorPublishFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
